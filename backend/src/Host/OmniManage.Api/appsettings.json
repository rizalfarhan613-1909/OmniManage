{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "PostgreSql": {
    "ConnectionString": "Host=localhost;Port=5433;Database=omnimanage_db;Username=omni_app;SslMode=Prefer;Include Error Detail=false",
    "MajorVersion": 16
  },
  "Jwt": {
    "Issuer": "https://auth.omnimanage.local",
    "Audience": "omnimanage-tenant",
    "KeyId": "tenant-signing-key-1",
    "PrivateKeyPem": "",
    "AccessTokenMinutes": 15
  },
  "RefreshTokens": {
    "LifetimeDays": 7
  },
  "Storage": {
    "Provider": "Local",
    "BucketName": "omnimanage",
    "Region": "us-east-1",
    "ServiceUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": true,
    "LocalRootPath": "App_Data/storage"
  },
  "AllowedHosts": "*"
}